# ─── Frontend (frontend/.env) ────────────────────────────────────────────
# true = fully local, no AWS calls, works with zero credentials (default)
# false = calls the deployed API Gateway endpoints below for progress/reports
VITE_DEMO_MODE=true

VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# ─── Backend (backend/.env, used by Lambdas locally / SAM local) ────────
DEMO_MODE=true
AWS_REGION=us-east-1
DDB_TABLE_PREFIX=ControlReady

# ─── Optional notifications ───────────────────────────────────────────────
SNS_TOPIC_ARN=

# ─── Reserved for future optional premium AI Tutor (NOT used in MVP) ────
# BEDROCK_MODEL_ID=
